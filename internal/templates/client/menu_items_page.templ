package client

import (
	"CommonTable/internal/templates/layout"
	"CommonTable/internal/templates/shared"
)

templ MenuItemsPage(locale string, branding shared.BrandingView, menuName string, items []shared.MenuItemView) {
	@layout.Layout(menuName, &branding, locale, menuItemsPageContent(locale, menuName, items))
}

templ menuItemsPageContent(locale string, menuName string, items []shared.MenuItemView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">
			{ menuName }
		</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, item := range items {
				@FoodItemCard(item, locale)
			}
			if len(items) == 0 {
				<p class="text-center italic gms-main-text col-span-full">No items on this menu.</p>
			}
		</div>
	</main>
}