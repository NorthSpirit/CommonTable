package client

import (
	"CommonTable/internal/templates/helpers"
	"CommonTable/internal/templates/shared"
)

templ RestaurantCard(restaurant shared.RestaurantView, locale string) {
	<a href={ templ.URL(helpers.WithLang("/restaurants/"+helpers.Itoa(restaurant.ID), locale)) } class="flex items-center gap-4 gms-hover-bg-light border gms-border-medium rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.02] p-4">
		<div class="flex-1">
			<h3 class="text-xl font-bold mb-1 gms-main-text">{ restaurant.Name }</h3>
			if restaurant.Description != "" {
				<p class="gms-main-text text-sm mt-1 line-clamp-2">{ restaurant.Description }</p>
			}
		</div>
		<div class="w-24 h-24 shrink-0 bg-gray-200 rounded flex items-center justify-center">
			if restaurant.LogoURL != "" {
				<img src={ restaurant.LogoURL } alt={ restaurant.Name } class="w-full h-full object-contain p-1"/>
			} else {
				<div class="text-gray-500 text-xs italic text-center">No Logo</div>
			}
		</div>
	</a>
}