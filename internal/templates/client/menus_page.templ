package client

import (
	"CommonTable/internal/templates/layout"
	"CommonTable/internal/templates/shared"
)

templ MenusPage(locale string, branding shared.BrandingView, quickNav []shared.QuickNavItemView, menus []shared.MenuView) {
	@layout.Layout(branding.Name+" - "+shared.T(locale, "menus_suffix"), &branding, locale, menusPageContent(locale, branding.Name, quickNav, menus))
}

templ menusPageContent(locale string, restaurantName string, quickNav []shared.QuickNavItemView, menus []shared.MenuView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">
			{ restaurantName }
		</h2>

		@QuickNav(quickNav, locale)

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, menu := range menus {
				@MenuCard(menu, locale)
			}
			if len(menus) == 0 {
				<p class="text-center italic gms-main-text col-span-full">No menus found for this restaurant.</p>
			}
		</div>
	</main>
}