package client

import (
	"CommonTable/internal/templates/helpers"
	"CommonTable/internal/templates/layout"
	"CommonTable/internal/templates/shared"
)

templ HomePage(locale string, content shared.HomepageView, restaurants []shared.RestaurantView) {
	@layout.Layout(shared.T(locale, "home_title"), nil, locale, homePageContent(locale, content, restaurants))
}

templ homePageContent(locale string, content shared.HomepageView, restaurants []shared.RestaurantView) {
	<div class="flex flex-col md:flex-row flex-1">
		<nav class="order-first w-full md:w-40 lg:w-1/6 gms-dark-bg m-0 md:border-r gms-border-dark sticky top-[35px] self-start z-10 md:h-fit md:m-1">
			<div>
				<h3 class="font-semibold text-lg px-2 md:my-1 gms-accent-text hidden md:block">Quick Navigation</h3>
				<ul class="flex flex-row flex-nowrap space-x-4 overflow-x-scroll border gms-border-medium pb-2 rounded-md md:border-none md:flex-col md:space-x-0 md:space-y-1 sm:items-start">
					<li class="shrink-0"><a href="#top" class="block px-2 py-0 rounded gms-hover-bg-light gms-accent-hover-text">Back to top</a></li>
					<li class="shrink-0"><a href="#welcome" class="block px-2 py-0 rounded gms-hover-bg-light gms-accent-hover-text">Welcome</a></li>
					for _, restaurant := range restaurants {
						<li class="shrink-0">
							<a href={ templ.URL(helpers.WithLang("/restaurants/"+helpers.Itoa(restaurant.ID), locale)) } class="block px-2 py-0 rounded gms-hover-bg-light gms-accent-hover-text whitespace-nowrap">
								{ restaurant.Name }
							</a>
						</li>
					}
				</ul>
			</div>
		</nav>

		<main class="flex-1 lg:w-4/6 p-6 gms-content-bg gms-main-text">
			<div id="welcome" class="[&_h1]:text-2xl [&_h1]:font-bold [&_h1]:mb-4 [&_h1]:text-center [&_h1]:border-b-2 [&_h1]:border-current [&_h1]:pb-2 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-6 [&_h2]:mb-2 [&_p]:mt-4 [&_u]:underline">
				@templ.Raw(content.WelcomeHTML)
			</div>
		</main>
	</div>
}