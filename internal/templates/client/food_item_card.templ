package client

import (
	"CommonTable/internal/templates/helpers"
	"CommonTable/internal/templates/shared"
)

templ FoodItemCard(item shared.MenuItemView, locale string) {
	<a href={ templ.URL(helpers.WithLang("/items/"+helpers.Itoa(item.ID), locale)) } class="block gms-hover-bg-light border gms-border-medium rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.02]">
		<div class="h-32 w-full gms-dark-bg flex items-center justify-center relative">
			if item.ImageURL != "" {
				<img src={ item.ImageURL } alt={ item.Name } class="h-full w-full object-cover"/>
			} else {
				<div class="gms-light-text opacity-70 italic">No Image Available</div>
			}
		</div>
		<div class="p-4">
			<h3 class="text-xl font-bold mb-1 gms-main-text">{ item.Name }</h3>
			<p class="text-lg gms-main-text font-semibold">€{ helpers.FormatPrice(item.Price) }</p>
			if item.Description != "" {
				<p class="gms-main-text text-sm line-clamp-2 mt-2">{ item.Description }</p>
			}
		</div>
	</a>
}