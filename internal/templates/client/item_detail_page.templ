package client

import (
	"CommonTable/internal/templates/helpers"
	"CommonTable/internal/templates/layout"
	"CommonTable/internal/templates/shared"
)

templ ItemDetailPage(locale string, branding shared.BrandingView, menuID int32, item shared.ItemDetailView) {
	@layout.Layout(item.Name, &branding, locale, itemDetailPageContent(locale, menuID, item))
}

templ itemDetailPageContent(locale string, menuID int32, item shared.ItemDetailView) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@BackLink(helpers.WithLang("/menus/"+helpers.Itoa(menuID), locale), "Back")
			<h2 class="text-2xl font-bold gms-main-text">{ item.Name }</h2>
		</div>

		<div class="w-full lg:w-[65%] mx-auto">
			if item.ImageURL != "" {
				<img src={ item.ImageURL } alt={ item.Name } class="w-full max-h-80 object-cover rounded-lg border gms-border-medium mb-4"/>
			}

			<p class="text-2xl font-bold gms-main-text mb-2">€{ helpers.FormatPrice(item.Price) }</p>

			if item.Description != "" {
				<p class="gms-main-text opacity-80 mb-6">{ item.Description }</p>
			}

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<div class="border gms-border-medium rounded-lg p-4">
					<h3 class="text-lg font-semibold mb-2 gms-main-text">Ingredients</h3>
					if len(item.Ingredients) == 0 {
						<p class="gms-main-text italic opacity-70">No ingredients listed.</p>
					} else {
						<ul class="list-disc pl-5 gms-main-text">
							for _, ing := range item.Ingredients {
								<li>{ ing }</li>
							}
						</ul>
					}
				</div>

				<div class="border gms-border-medium rounded-lg p-4">
					<h3 class="text-lg font-semibold mb-2 gms-main-text">Allergens</h3>
					if len(item.Allergens) == 0 {
						<p class="gms-main-text italic opacity-70">No known allergens listed.</p>
					} else {
						<ul class="list-disc pl-5 gms-main-text">
							for _, allergen := range item.Allergens {
								<li>{ allergen }</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	</main>
}