package table

import "CommonTable/internal/templates/admin/adminshared"

templ TableFormPage(isEdit bool, table adminshared.TableView, errorMessage string) {
	@adminshared.Layout(tableFormTitle(isEdit), tableFormContent(isEdit, table, errorMessage))
}

func tableFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit Table"
	}
	return "New Table"
}

func tableFormAction(isEdit bool, id int32) templ.SafeURL {
	if isEdit {
		return templ.URL("/admin/tables/" + adminshared.Itoa(id) + "/edit")
	}
	return templ.URL("/admin/tables/new")
}

templ tableFormContent(isEdit bool, table adminshared.TableView, errorMessage string) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">
			{ tableFormTitle(isEdit) }
		</h2>

		if errorMessage != "" {
			<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
		}

		<form method="POST" action={ tableFormAction(isEdit, table.ID) } class="max-w-lg">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Details</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Number</span>
					<input type="number" name="number" min="1" value={ adminshared.Itoa(table.Number) } required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Capacity</span>
					<input type="number" name="capacity" min="1" value={ adminshared.Itoa(table.Capacity) } required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Section</span>
					<input type="text" name="section" value={ table.Section } class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				if isEdit {
                	<label class="block">
                		<span class="text-sm font-medium mb-1 block">Status</span>
                		<p class="text-xs opacity-70 mb-1">Manual floor/seating status (e.g. for host use) — separate from live order activity shown on Table Status pages.</p>
                		<select name="status" class="p-2 border gms-border-medium rounded-md w-full">
                			<option value="free" selected?={ table.Status == "free" }>Free</option>
                			<option value="occupied" selected?={ table.Status == "occupied" }>Occupied</option>
                			<option value="reserved" selected?={ table.Status == "reserved" }>Reserved</option>
                		</select>
                	</label>
                }
			</fieldset>

			<div class="flex justify-end mt-4">
				<input type="submit" value="Save" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>
}