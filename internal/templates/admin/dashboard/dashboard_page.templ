package admin

import "CommonTable/internal/templates/admin/adminshared"

templ DashboardPage() {
	@adminshared.Layout("Dashboard", dashboardPageContent())
}

templ dashboardPageContent() {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-4 gms-main-text">Welcome, Admin</h2>
		<p class="gms-main-text">Use the navigation above to manage homepage content and restaurants.</p>
	</main>
}