package restaurant

import "CommonTable/internal/templates/admin/adminshared"

templ RestaurantDetailPage(restaurant adminshared.RestaurantView) {
	@adminshared.Layout(restaurant.Name, restaurantDetailContent(restaurant))
}

templ restaurantDetailContent(restaurant adminshared.RestaurantView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			<div class="w-20 h-20 shrink-0 bg-gray-200 rounded flex items-center justify-center">
				if restaurant.LogoURL != "" {
					<img src={ restaurant.LogoURL } alt={ restaurant.Name } class="w-full h-full object-contain p-1"/>
				}
			</div>
			<div>
				<h2 class="text-2xl font-bold gms-main-text">{ restaurant.Name }</h2>
				if restaurant.Description != "" {
					<p class="gms-main-text text-sm mt-1">{ restaurant.Description }</p>
				}
			</div>
		</div>

		<div class="flex flex-wrap gap-2">
			<a href={ templ.URL("/admin/restaurants/" + adminshared.Itoa(restaurant.ID) + "/employees") } class="inline-block px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
				Manage Employees
			</a>
			<a href={ templ.URL("/admin/restaurants/" + adminshared.Itoa(restaurant.ID) + "/menus") } class="inline-block px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
				Manage Menus
			</a>
			<a href={ templ.URL("/admin/restaurants/" + adminshared.Itoa(restaurant.ID) + "/orders") } class="inline-block px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
				View Orders
			</a>
			<a href={ templ.URL("/admin/restaurants/" + adminshared.Itoa(restaurant.ID) + "/table-status") } class="inline-block px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
				Table Status
			</a>
			<a href={ templ.URL("/admin/restaurants/" + adminshared.Itoa(restaurant.ID) + "/chat") } class="inline-block px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
				View Chat
			</a>
			<a href={ templ.URL("/admin/restaurants/" + adminshared.Itoa(restaurant.ID) + "/export") } class="inline-block px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
            	Export Menu (JSON)
            </a>
		</div>
	</main>
}