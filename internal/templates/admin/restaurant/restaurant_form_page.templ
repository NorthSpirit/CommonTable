package restaurant

import "CommonTable/internal/templates/admin/adminshared"

templ RestaurantFormPage(isEdit bool, restaurant adminshared.RestaurantView, errorMessage string) {
	@adminshared.Layout(formTitle(isEdit), restaurantFormContent(isEdit, restaurant, errorMessage))
}

func formTitle(isEdit bool) string {
	if isEdit {
		return "Edit Restaurant"
	}
	return "New Restaurant"
}

func formAction(isEdit bool, id int32) templ.SafeURL {
	if isEdit {
		return templ.URL("/admin/restaurants/" + adminshared.Itoa(id) + "/edit")
	}
	return templ.URL("/admin/restaurants/new")
}

templ restaurantFormContent(isEdit bool, restaurant adminshared.RestaurantView, errorMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@adminshared.BackLink("/admin/restaurants", "Back")
			<h2 class="text-2xl font-bold gms-main-text">
				{ formTitle(isEdit) }
			</h2>
		</div>

		if errorMessage != "" {
			<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm">{ errorMessage }</p>
		}

		<form method="POST" action={ formAction(isEdit, restaurant.ID) } enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full items-start">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Details</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Name</span>
					<input type="text" name="name" value={ restaurant.Name } maxlength="255" required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Address</span>
					<input type="text" name="address" value={ restaurant.Address } class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Phone</span>
					<input type="text" name="phone" value={ restaurant.Phone } maxlength="30" class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Email</span>
					<input type="email" name="email" value={ restaurant.Email } maxlength="254" class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Description (English)</span>
					<textarea name="description" rows="4" class="p-2 border gms-border-medium rounded-md w-full">{ restaurant.Description }</textarea>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Description (Alt Language, optional)</span>
					<textarea name="description_alt" rows="4" class="p-2 border gms-border-medium rounded-md w-full">{ restaurant.DescriptionAlt }</textarea>
				</label>

				if isEdit {
					<label class="block">
						<span class="text-sm font-medium mb-1 block">New Password (leave blank to keep current)</span>
						<input type="password" name="password" maxlength="72" class="p-2 border gms-border-medium rounded-md w-full"/>
					</label>
				} else {
					<label class="block">
						<span class="text-sm font-medium mb-1 block">Password</span>
						<input type="password" name="password" maxlength="72" required class="p-2 border gms-border-medium rounded-md w-full"/>
					</label>
				}
			</fieldset>

			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Logo</legend>

				<img id="logo-preview" src={ restaurant.LogoURL } alt="Logo preview" class={ "h-32 w-32 object-cover rounded border gms-border-medium mb-4", templ.KV("hidden", restaurant.LogoURL == "") }/>
				<div id="logo-preview-placeholder" class={ "h-32 w-32 flex items-center justify-center rounded border gms-border-medium mb-4", templ.KV("hidden", restaurant.LogoURL != "") }>
					<p class="text-sm italic opacity-70">No logo set.</p>
				</div>

				<label class="block">
					<span class="text-sm font-medium mb-1 block">Replace Logo</span>
					<input type="file" name="logo" data-preview-target="logo-preview" accept=".jpg,.jpeg,.png,.webp" class="p-2 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
				</label>
			</fieldset>

			<div class="lg:col-span-2 flex justify-end">
				<input type="submit" value="Save" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>

	<script src="/assets/jsscripts/image_preview.js"></script>
}