package allergen

import "CommonTable/internal/templates/admin/adminshared"

templ AllergenUsagePage(allergenName string, items []adminshared.UsageItemView) {
	@adminshared.Layout(allergenName+" - Used In", allergenUsageContent(allergenName, items))
}

templ allergenUsageContent(allergenName string, items []adminshared.UsageItemView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">
			Items containing "{ allergenName }"
		</h2>

		if len(items) == 0 {
			<p class="text-center italic gms-main-text">Not currently used by any food item. Safe to delete.</p>
		} else {
			<p class="text-center mb-4 opacity-80">Used by { adminshared.Itoa(int32(len(items))) } item(s). Deleting this allergen will remove it from all of them.</p>
			<ul class="list-disc pl-5 max-w-md mx-auto">
				for _, item := range items {
					<li class="gms-main-text">{ item.Name }</li>
				}
			</ul>
		}
	</main>
}