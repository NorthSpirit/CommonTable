package allergen

import "CommonTable/internal/templates/admin/adminshared"

templ AllergenUsagePage(allergenName string, items []adminshared.UsageItemView) {
	@adminshared.Layout(allergenName+" - Used In", allergenUsageContent(allergenName, items))
}

templ allergenUsageContent(allergenName string, items []adminshared.UsageItemView) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@adminshared.BackLink("/admin/allergens", "Back")
			<h2 class="text-2xl font-bold gms-main-text">
				Items containing "{ allergenName }"
			</h2>
		</div>

		<div class="w-full lg:w-[65%] mx-auto">
			if len(items) == 0 {
				<p class="italic gms-main-text">Not currently used by any food item. Safe to delete.</p>
			} else {
				<p class="mb-4 opacity-80">Used by { adminshared.Itoa(int32(len(items))) } item(s). Deleting this allergen will remove it from all of them.</p>
				<ul class="list-disc pl-5">
					for _, item := range items {
						<li class="gms-main-text">{ item.Name }</li>
					}
				</ul>
			}
		</div>
	</main>
}