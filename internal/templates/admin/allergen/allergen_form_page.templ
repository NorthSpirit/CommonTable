package allergen

import "CommonTable/internal/templates/admin/adminshared"

templ AllergenFormPage(isEdit bool, allergen adminshared.AllergenAdminView, errorMessage string) {
	@adminshared.Layout(allergenFormTitle(isEdit), allergenFormContent(isEdit, allergen, errorMessage))
}

func allergenFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit Allergen"
	}
	return "New Allergen"
}

func allergenFormAction(isEdit bool, id int32) templ.SafeURL {
	if isEdit {
		return templ.URL("/admin/allergens/" + adminshared.Itoa(id) + "/edit")
	}
	return templ.URL("/admin/allergens/new")
}

templ allergenFormContent(isEdit bool, allergen adminshared.AllergenAdminView, errorMessage string) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">
			{ allergenFormTitle(isEdit) }
		</h2>

		if errorMessage != "" {
			<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
		}

		<form method="POST" action={ allergenFormAction(isEdit, allergen.ID) } class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Name &amp; Code</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Name</span>
					<input type="text" name="name" value={ allergen.Name } required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Name (Alt Language)</span>
					<input type="text" name="name_alt" value={ allergen.NameAlt } class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block">
					<span class="text-sm font-medium mb-1 flex items-center gap-1">
						Code
						<span
							class="inline-flex items-center justify-center w-4 h-4 rounded-full text-xs font-bold border gms-border-medium cursor-help"
							title="A short internal shorthand for this allergen (e.g. 'gluten', 'GF', 'nuts'). There is no universal allergen coding standard — restaurants define their own menu keys — so this is just your own label to keep things consistent across menus."
						>?</span>
					</span>
					<input type="text" name="code" value={ allergen.Code } required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>
			</fieldset>

			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Description</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Description</span>
					<textarea name="description" rows="6" class="p-2 border gms-border-medium rounded-md w-full">{ allergen.Description }</textarea>
				</label>

				<label class="block">
					<span class="text-sm font-medium mb-1 block">Description (Alt Language)</span>
					<textarea name="description_alt" rows="6" class="p-2 border gms-border-medium rounded-md w-full">{ allergen.DescriptionAlt }</textarea>
				</label>
			</fieldset>

			<div class="lg:col-span-2 flex justify-end">
				<input type="submit" value="Save" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>
}