package adminshared

templ ChangePasswordPage(successMessage string, errorMessage string) {
	@Layout("Change Password", changePasswordContent(successMessage, errorMessage))
}

templ changePasswordContent(successMessage string, errorMessage string) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text flex flex-col items-center">
		<div class="w-full max-w-sm p-6 rounded-lg shadow-lg border gms-border-medium gms-dark-bg gms-light-text">
			<h2 class="text-xl font-bold mb-4 text-center">Change Admin Password</h2>

			if successMessage != "" {
				<p class="mb-4 p-2 rounded bg-green-100 text-green-800 text-sm text-center">{ successMessage }</p>
			}
			if errorMessage != "" {
				<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
			}

			<form method="POST" action="/admin/change-password" class="space-y-4">
				<label class="block">
					<span class="text-sm font-medium mb-1 block">Current Password</span>
					<input type="password" name="current_password" required autofocus class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium mb-1 block">New Password</span>
					<input type="password" name="new_password" required class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium mb-1 block">Confirm New Password</span>
					<input type="password" name="new_password_confirm" required class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<button type="submit" class="w-full px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
					Change Password
				</button>
			</form>
		</div>
	</main>
}