package homepage

import "CommonTable/internal/templates/admin/adminshared"

templ HomepagePage(welcomeText string, welcomeTextAlt string, imageOneURL string, imageTwoURL string, successMessage string) {
	@adminshared.Layout("Homepage Content", homepagePageContent(welcomeText, welcomeTextAlt, imageOneURL, imageTwoURL, successMessage))
}

templ homepagePageContent(welcomeText string, welcomeTextAlt string, imageOneURL string, imageTwoURL string, successMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold gms-main-text mb-6 border-b-2 gms-border-medium pb-4">Homepage Content</h2>

		if successMessage != "" {
			<p class="mb-4 p-2 rounded bg-green-100 text-green-800 text-sm">{ successMessage }</p>
		}

		<form method="POST" action="/admin/homepage" enctype="multipart/form-data" data-wysiwyg-form class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Welcome Text</legend>

				<div class="mb-4 p-3 rounded-lg gms-dark-bg gms-light-text text-sm">
					<p class="font-semibold mb-1 gms-demo-accent-text">Tips</p>
					<ul class="list-disc pl-5 space-y-0.5">
						<li>Use the toolbar for headings, <strong>bold</strong> and <u>underline</u>.</li>
						<li><code>{ "{{image1}}" }</code> / <code>{ "{{image2}}" }</code> — buttons insert a placeholder where that image will appear (otherwise both are added at the end automatically).</li>
						<li><code>---</code> on its own line — the Spacer button inserts a visual spacer line.</li>
					</ul>
				</div>

				<div class="block mb-4">
					<span class="text-sm font-medium mb-1 block">English</span>
					@editorToolbar("toolbar-en")
					<div data-wysiwyg data-input="welcome_text" data-toolbar="toolbar-en" data-required="true" data-label="English welcome text" class="gms-content-bg gms-main-text border gms-border-medium"></div>
					<input type="hidden" id="welcome_text" name="welcome_text" value={ welcomeText }/>
				</div>

				<div class="block">
					<span class="text-sm font-medium mb-1 block">Alt Language (optional — falls back to English if blank)</span>
					@editorToolbar("toolbar-alt")
					<div data-wysiwyg data-input="welcome_text_alt" data-toolbar="toolbar-alt" data-required="false" class="gms-content-bg gms-main-text border gms-border-medium"></div>
					<input type="hidden" id="welcome_text_alt" name="welcome_text_alt" value={ welcomeTextAlt }/>
				</div>
			</fieldset>

			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Images</legend>

				<div class="grid grid-cols-2 gap-4 mb-4">
					<div>
						<span class="text-sm font-medium mb-1 block">Image One</span>
						<img id="image-one-preview" src={ imageOneURL } alt="Image one preview" class={ "h-48 w-full object-cover rounded border gms-border-medium", templ.KV("hidden", imageOneURL == "") }/>
						<div id="image-one-preview-placeholder" class={ "h-48 w-full flex items-center justify-center rounded border gms-border-medium", templ.KV("hidden", imageOneURL != "") }>
							<p class="text-sm italic opacity-70">No image set.</p>
						</div>
					</div>
					<div>
						<span class="text-sm font-medium mb-1 block">Image Two</span>
						<img id="image-two-preview" src={ imageTwoURL } alt="Image two preview" class={ "h-48 w-full object-cover rounded border gms-border-medium", templ.KV("hidden", imageTwoURL == "") }/>
						<div id="image-two-preview-placeholder" class={ "h-48 w-full flex items-center justify-center rounded border gms-border-medium", templ.KV("hidden", imageTwoURL != "") }>
							<p class="text-sm italic opacity-70">No image set.</p>
						</div>
					</div>
				</div>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Replace Image One</span>
					<input type="file" name="image_one" data-preview-target="image-one-preview" accept=".jpg,.jpeg,.png,.webp" class="p-2 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
				</label>

				<label class="block">
					<span class="text-sm font-medium mb-1 block">Replace Image Two</span>
					<input type="file" name="image_two" data-preview-target="image-two-preview" accept=".jpg,.jpeg,.png,.webp" class="p-2 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
				</label>

				<span class="text-xs opacity-70 block mt-2">Uploading a new file replaces the corresponding image above.</span>
			</fieldset>

			<div class="lg:col-span-2 flex justify-end">
				<input type="submit" value="Save Changes" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"/>
	<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
	<script src="/assets/jsscripts/image_preview.js"></script>
	<script src="/assets/jsscripts/wysiwyg.js"></script>
}

templ editorToolbar(id string) {
	<div id={ id } class="gms-content-bg gms-main-text border gms-border-medium">
		<button type="button" class="ql-header" value="1"></button>
		<button type="button" class="ql-header" value="2"></button>
		<button type="button" class="ql-bold"></button>
		<button type="button" class="ql-underline"></button>
		<button type="button" class="wysiwyg-token" data-token={ "{{image1}}" }>Image 1</button>
		<button type="button" class="wysiwyg-token" data-token={ "{{image2}}" }>Image 2</button>
		<button type="button" class="wysiwyg-token" data-token="---">Spacer</button>
	</div>
}