package homepage

import (
	"strconv"

	"CommonTable/internal/htmlcontent"
	"CommonTable/internal/templates/admin/adminshared"
)

templ HomepagePage(welcomeText string, welcomeTextAlt string, images []htmlcontent.Image, successMessage string) {
	@adminshared.Layout("Homepage Content", homepagePageContent(welcomeText, welcomeTextAlt, images, successMessage))
}

templ homepagePageContent(welcomeText string, welcomeTextAlt string, images []htmlcontent.Image, successMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold gms-main-text mb-6 border-b-2 gms-border-medium pb-4">Homepage Content</h2>
		if successMessage != "" {
			<p class="mb-4 p-2 rounded bg-green-100 text-green-800 text-sm">{ successMessage }</p>
		}
		<form method="POST" action="/admin/homepage" enctype="multipart/form-data" data-wysiwyg-form class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Welcome Text</legend>
				<div class="mb-4 p-3 rounded-lg gms-dark-bg gms-light-text text-sm">
					<p class="font-semibold mb-1 gms-demo-accent-text">Tips</p>
					<ul class="list-disc pl-5 space-y-0.5">
						<li>Use the toolbar for headings, <strong>bold</strong> and <u>underline</u>.</li>
						<li><code>{ "{{image1}}" }</code> … <code>{ "{{image4}}" }</code> — buttons insert a placeholder where that image will appear (an image with no placeholder is added at the end automatically).</li>
						<li><code>---</code> on its own line — the Spacer button inserts a visual spacer line.</li>
					</ul>
				</div>
				<div class="block mb-4">
					<span class="text-sm font-medium mb-1 block">English</span>
					<div class="border gms-border-medium rounded-md overflow-hidden">
						@editorToolbar("toolbar-en")
						<div data-wysiwyg data-input="welcome_text" data-toolbar="toolbar-en" data-required="true" data-label="English welcome text" class="gms-content-bg gms-main-text"></div>
					</div>
					<input type="hidden" id="welcome_text" name="welcome_text" value={ welcomeText }/>
				</div>
				<div class="block">
					<span class="text-sm font-medium mb-1 block">Alt Language (optional — falls back to English if blank)</span>
					<div class="border gms-border-medium rounded-md overflow-hidden">
						@editorToolbar("toolbar-alt")
						<div data-wysiwyg data-input="welcome_text_alt" data-toolbar="toolbar-alt" data-required="false" class="gms-content-bg gms-main-text"></div>
					</div>
					<input type="hidden" id="welcome_text_alt" name="welcome_text_alt" value={ welcomeTextAlt }/>
				</div>
			</fieldset>
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Images</legend>
				for i, img := range images {
					@imageSlot(strconv.Itoa(i+1), img)
				}
				<span class="text-xs opacity-70 block mt-2">Width is a percentage of the text column. A shape other than Original crops the picture (it is never stretched). Position: 0 = left, 50 = centered, 100 = right.</span>
			</fieldset>
			<div class="lg:col-span-2 flex justify-end">
				<input type="submit" value="Save Changes" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"/>
	<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
	<script src="/assets/jsscripts/image_preview.js"></script>
	<script src="/assets/jsscripts/wysiwyg.js"></script>
}

templ editorToolbar(id string) {
	<div class="border-b gms-border-medium">
		<div id={ id } class="gms-content-bg gms-main-text">
			<button type="button" class="ql-header" value="1"></button>
			<button type="button" class="ql-header" value="2"></button>
			<button type="button" class="ql-bold"></button>
			<button type="button" class="ql-underline"></button>
			<button type="button" class="wysiwyg-token" data-token={ "{{image1}}" }>Image 1</button>
			<button type="button" class="wysiwyg-token" data-token={ "{{image2}}" }>Image 2</button>
			<button type="button" class="wysiwyg-token" data-token="---">Spacer</button>
		</div>
	</div>
}

templ imageSlot(n string, img htmlcontent.Image) {
	<div class="mb-4 p-3 border rounded-lg gms-border-medium">
		<span class="text-sm font-semibold mb-2 block">{ "Image " + n }</span>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<img id={ "image-" + n + "-preview" } src={ img.URL } alt={ "Image " + n + " preview" } class={ "h-36 w-full object-cover rounded border gms-border-medium", templ.KV("hidden", img.URL == "") }/>
				<div id={ "image-" + n + "-preview-placeholder" } class={ "h-36 w-full flex items-center justify-center rounded border gms-border-medium", templ.KV("hidden", img.URL != "") }>
					<p class="text-sm italic opacity-70">No image set.</p>
				</div>
			</div>
			<div class="space-y-2">
				<label class="block">
					<span class="text-xs font-medium block">Upload / replace</span>
					<input type="file" name={ "image_" + n } data-preview-target={ "image-" + n + "-preview" } accept=".jpg,.jpeg,.png,.webp" class="p-1 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
				</label>
				<div class="grid grid-cols-2 gap-2">
					<label class="block">
						<span class="text-xs font-medium block">Width (10–100 %)</span>
						<input type="number" name={ "width_" + n } min="10" max="100" value={ strconv.Itoa(img.WidthPercent) } class="p-1 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
					</label>
					<label class="block">
						<span class="text-xs font-medium block">Position (0–100)</span>
						<input type="number" name={ "position_" + n } min="0" max="100" value={ strconv.Itoa(img.PositionPercent) } class="p-1 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
					</label>
				</div>
				<label class="block">
					<span class="text-xs font-medium block">Shape</span>
					<select name={ "shape_" + n } class="p-1 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text">
						for _, sh := range htmlcontent.Shapes {
							<option value={ sh.Value } selected?={ sh.Value == img.Shape }>{ sh.Label }</option>
						}
					</select>
				</label>
				if img.URL != "" {
					<label class="flex items-center gap-2 text-xs">
						<input type="checkbox" name={ "remove_" + n } value="1"/>
						Remove this image
					</label>
				}
			</div>
		</div>
	</div>
}
