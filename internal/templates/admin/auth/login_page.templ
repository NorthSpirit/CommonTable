package admin

import "CommonTable/internal/templates/admin/adminshared"

templ LoginPage(errorMessage string) {
	@adminshared.Layout("Admin Login", loginPageContent(errorMessage))
}

templ loginPageContent(errorMessage string) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">Admin Login</h2>
		<p class="gms-main-text mb-6 text-center">Please enter your credentials to access the admin panel.</p>

		<div id="login-form" class="mx-auto w-full max-w-sm p-6 gms-dark-bg gms-light-text rounded-lg shadow-xl border gms-border-medium">
			if errorMessage != "" {
				<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
			}

			<form method="POST" action="/admin/login" class="space-y-4">
				<label class="block">
					<span class="text-sm font-medium mb-1 block">Username:</span>
					<input type="text" name="username" required autofocus class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium mb-1 block">Password:</span>
					<div class="flex gap-2">
						<input id="password-field" type="password" name="password" required class="p-2 border rounded-md w-full gms-dark-text"/>
						<button type="button" id="toggle-password" class="px-3 rounded-md border gms-border-medium gms-content-bg gms-dark-text gms-hover-bg-light text-xs whitespace-nowrap">
                        	Show
                        </button>
					</div>
				</label>
				<div class="flex justify-end space-x-4 pt-2">
					<input type="reset" value="Clear" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-clear border gms-border-medium"/>
					<input type="submit" value="Log In" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
				</div>
			</form>
		</div>
	</main>

	<script src="/assets/jsscripts/toggle_password.js"></script>
}