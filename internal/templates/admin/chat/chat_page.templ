package chat

import "CommonTable/internal/templates/admin/adminshared"

templ ChatPage(restaurantID int32, restaurantName string, messages []adminshared.ChatMessageView) {
	@adminshared.Layout(restaurantName+" - Chat", chatPageContent(restaurantID, messages))
}

templ chatPageContent(restaurantID int32, messages []adminshared.ChatMessageView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text max-w-3xl mx-auto w-full">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">Restaurant Chat</h2>

		<div id="chat-messages" data-last-id={ lastMessageID(messages) } data-poll-url={ "/admin/restaurants/" + adminshared.Itoa(restaurantID) + "/chat/messages" } class="border gms-border-medium rounded-lg p-4 h-96 overflow-y-auto space-y-2">
			for _, m := range messages {
				<div class="text-sm gms-main-text" data-message-id={ adminshared.Itoa(m.ID) }>
					<span class="font-bold">{ m.SenderName }</span>
					<span class="opacity-60">({ m.SentAt }):</span>
					{ " " + m.Message }
				</div>
			}
			if len(messages) == 0 {
				<p class="text-center italic opacity-70">No messages yet.</p>
			}
		</div>
	</main>

	<script src="/assets/jsscripts/chat_poll.js"></script>
}

func lastMessageID(messages []adminshared.ChatMessageView) string {
	if len(messages) == 0 {
		return "0"
	}
	return adminshared.Itoa(messages[len(messages)-1].ID)
}