package ingredient

import "CommonTable/internal/templates/admin/adminshared"

templ IngredientFormPage(isEdit bool, ingredient adminshared.IngredientView, errorMessage string) {
	@adminshared.Layout(ingredientFormTitle(isEdit), ingredientFormContent(isEdit, ingredient, errorMessage))
}

func ingredientFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit Ingredient"
	}
	return "New Ingredient"
}

func ingredientFormAction(isEdit bool, id int32) templ.SafeURL {
	if isEdit {
		return templ.URL("/admin/ingredients/" + adminshared.Itoa(id) + "/edit")
	}
	return templ.URL("/admin/ingredients/new")
}

templ ingredientFormContent(isEdit bool, ingredient adminshared.IngredientView, errorMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@adminshared.BackLink("/admin/ingredients", "Back")
			<h2 class="text-2xl font-bold gms-main-text">
				{ ingredientFormTitle(isEdit) }
			</h2>
		</div>

		if errorMessage != "" {
			<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm w-full lg:w-[65%] mx-auto">{ errorMessage }</p>
		}

		<form method="POST" action={ ingredientFormAction(isEdit, ingredient.ID) } class="w-full lg:w-[65%] mx-auto">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Details</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Name</span>
					<input type="text" name="name" value={ ingredient.Name } maxlength="255" required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block">
					<span class="text-sm font-medium mb-1 block">Description</span>
					<textarea name="description" rows="6" class="p-2 border gms-border-medium rounded-md w-full">{ ingredient.Description }</textarea>
				</label>
			</fieldset>

			<div class="flex justify-end mt-4">
				<input type="submit" value="Save" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>
}