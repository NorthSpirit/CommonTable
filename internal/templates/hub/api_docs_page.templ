package hub

templ ApiDocsPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable - Waiter API</title>
			<meta charset="utf-8"/>
			<link rel="icon" type="image/png" href="/assets/images/favicon.png"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link id="themeCSS" rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<link id="themeCSSAlt" rel="stylesheet" href="/assets/css/CTStyleAlt.css" disabled/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body { height: 100%; }
				:root { font-family: 'Lora', serif; }
				a { color: inherit; }
				code { font-family: monospace; }
			</style>
		</head>
		<body>
			<div class="min-h-screen flex flex-col gms-dark-bg">
				<header class="gms-dark-bg gms-light-text p-2 shadow-md border-b-4 gms-border-dark">
					<div class="container mx-auto text-center">
						<h1 class="gms-title-text lg:text-4xl sm:text-3xl font-bold mb-1">CommonTable</h1>
						<p class="text-sm gms-demo-accent-text">Waiter API Reference</p>
					</div>
				</header>

				<nav class="border-b-4 gms-border-dark uppercase font-bold sticky top-0 z-50 flex gms-content-bg">
					<a href="/hub" class="flex-1 block py-2 text-center gms-content-bg gms-main-text gms-hover-bg-light">&larr; Back to Hub</a>
					<a href="#" id="MColour" class="flex-1 block py-2 text-center gms-content-bg gms-main-text gms-hover-bg-light border-l-2 gms-border-medium">Palette Swap</a>
				</nav>

				<main class="flex-1 px-6 py-6 gms-dark-bg">
					<div class="w-full lg:w-[65%] mx-auto">
						<p class="text-sm gms-light-text mb-6">
							Reference for building a client against the waiter-facing JSON API. This is what the official waiter app itself talks to.
						</p>

						<div class="gms-content-bg gms-main-text rounded-lg shadow-lg p-4 mb-6">
							<h2 class="text-lg font-bold mb-2">Authentication</h2>
							<p class="text-sm mb-2">
								Login is two-step: verify the restaurant, then verify the employee within it. The employee step returns a bearer token, sent as <code>Authorization: Bearer &lt;token&gt;</code> on every subsequent request.
							</p>
							<p class="text-sm">
								Tokens use a sliding expiry: every authenticated response may include an <code>X-Refreshed-Token</code> header — store and use whichever token was most recently received. An unused session lapses after roughly one hour.
							</p>
						</div>

						@endpointGroup("Auth", []endpoint{
							{"POST", "/api/waiter/login", "Verify restaurant name + password. Returns restaurant_id, restaurant_name, logo_url.", false},
							{"POST", "/api/waiter/login/employee", "Verify employee name + PIN within a restaurant. Requires waiter or manager role. Returns a bearer token.", false},
							{"GET", "/api/waiter/me", "Returns the current employee's identity from their token.", true},
						})

						@endpointGroup("Menus & Items", []endpoint{
							{"GET", "/api/waiter/menus", "List all menus for the logged-in restaurant.", true},
							{"GET", "/api/waiter/menus/{menuID}/items", "List items on a specific menu, including price and availability.", true},
							{"GET", "/api/waiter/items/{itemID}", "Full item detail: description, ingredients, allergens, price.", true},
							{"GET", "/api/waiter/search?q=", "Search all of the restaurant's items by name.", true},
						})

						@endpointGroup("Quick Items (Pinned)", []endpoint{
							{"GET", "/api/waiter/quick-items", "List the current employee's pinned items.", true},
							{"POST", "/api/waiter/quick-items", "Pin an item. Body: item_id, sort_order. Max 15 per employee.", true},
							{"DELETE", "/api/waiter/quick-items/{itemID}", "Unpin an item.", true},
							{"PATCH", "/api/waiter/quick-items/{itemID}", "Change a pinned item's sort order.", true},
						})

						@endpointGroup("Tables", []endpoint{
							{"GET", "/api/waiter/tables", "List all tables, with whether the current restaurant has an active order at each.", true},
						})

						@endpointGroup("Orders", []endpoint{
							{"POST", "/api/waiter/orders", "Submit an order. Body: idempotency_key, table_id (null for take-out), items[]. Appends to an already-open table order if one exists.", true},
							{"GET", "/api/waiter/orders", "List the current employee's own active (non-delivered/cancelled) orders.", true},
							{"POST", "/api/waiter/orders/{orderID}/cancel", "Cancel an order. Only allowed while its status is still pending.", true},
						})

						@endpointGroup("Chat", []endpoint{
							{"GET", "/api/waiter/chat/messages", "List all chat messages for the restaurant.", true},
							{"GET", "/api/waiter/chat/messages/after/{id}", "List messages newer than a given message ID — used for polling.", true},
							{"POST", "/api/waiter/chat/send", "Send a chat message. Body: message.", true},
						})

						<div class="text-xs gms-demo-accent-text mt-8 text-center">
							<p>All requests/responses are JSON. Errors return { "{" }"error": "..."{ "}" } with a 4xx/5xx status.</p>
						</div>
					</div>
				</main>

				<footer class="gms-dark-bg gms-light-text p-4 text-center gms-accent-text">
					<p>&copy; 2026 Mantas "IndomitableWastage" Jurevičius</p>
				</footer>
			</div>

			<script src="/assets/jsscripts/colour_swap.js"></script>
		</body>
	</html>
}

type endpoint struct {
	Method       string
	Path         string
	Description  string
	AuthRequired bool
}

templ endpointGroup(title string, endpoints []endpoint) {
	<div class="mb-6">
		<h2 class="text-lg font-bold gms-light-text mb-2">{ title }</h2>
		<div class="gms-content-bg gms-main-text rounded-lg shadow-lg divide-y gms-border-medium">
			for _, e := range endpoints {
				<div class="p-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
					<span class={ "text-xs font-bold px-2 py-0.5 rounded w-fit", methodColor(e.Method) }>{ e.Method }</span>
					<code class="text-sm font-bold">{ e.Path }</code>
					if e.AuthRequired {
						<span class="text-xs gms-dark-text">(auth required)</span>
					}
					<span class="text-xs gms-dark-text sm:ml-auto">{ e.Description }</span>
				</div>
			}
		</div>
	</div>
}

func methodColor(method string) string {
	switch method {
	case "GET":
		return "bg-blue-600 text-white"
	case "POST":
		return "bg-green-600 text-white"
	case "PATCH":
		return "bg-yellow-600 text-white"
	case "DELETE":
		return "bg-red-600 text-white"
	default:
		return "bg-gray-600 text-white"
	}
}