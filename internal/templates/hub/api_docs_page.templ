package hub
import "strconv"

templ ApiDocsPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable - Waiter API</title>
			<meta charset="utf-8"/>
			<link rel="icon" type="image/png" href="/assets/images/favicon.png"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link id="themeCSS" rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<link id="themeCSSAlt" rel="stylesheet" href="/assets/css/CTStyleAlt.css" disabled/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body { height: 100%; }
				:root { font-family: 'Lora', serif; }
				a { color: inherit; }
				code { font-family: monospace; }
			</style>
		</head>
		<body>
			<div class="min-h-screen flex flex-col gms-dark-bg">
				<header class="gms-dark-bg gms-light-text p-2 shadow-md border-b-4 gms-border-dark">
					<div class="container mx-auto text-center">
						<h1 class="gms-title-text lg:text-4xl sm:text-3xl font-bold mb-1">CommonTable</h1>
						<p class="text-sm gms-demo-accent-text">Waiter API Reference</p>
					</div>
				</header>

				<nav class="border-b-4 gms-border-dark uppercase font-bold sticky top-0 z-50 flex gms-content-bg">
					<a href="/hub" class="flex-1 block py-2 text-center gms-content-bg gms-main-text gms-hover-bg-light">&larr; Back to Hub</a>
					<a href="#" id="MColour" class="flex-1 block py-2 text-center gms-content-bg gms-main-text gms-hover-bg-light border-l-2 gms-border-medium">Palette Swap</a>
				</nav>

				<main class="flex-1 px-6 py-6 gms-dark-bg">
					<div class="w-full lg:w-[65%] mx-auto">
						<p class="text-sm gms-light-text mb-6">
							Reference for building a client against the waiter-facing JSON API. This is what the official waiter app itself talks to.
						</p>

						<div class="gms-content-bg gms-main-text rounded-lg shadow-lg p-4 mb-6">
							<h2 class="text-lg font-bold mb-2">Authentication</h2>
							<p class="text-sm mb-2">
								Login is two-step: verify the restaurant, then verify the employee within it. The second step returns a bearer token, sent as <code>Authorization: Bearer &lt;token&gt;</code> on every subsequent request.
							</p>
							<p class="text-sm">
								Tokens use a sliding expiry: every authenticated response may include an <code>X-Refreshed-Token</code> header — store and use whichever token was most recently received. An unused session lapses after roughly one hour.
							</p>
						</div>

						<div class="flex justify-end gap-2 mb-4 text-xs font-bold uppercase">
							<button type="button" id="apiExpandAll" class="px-3 py-1 rounded gms-content-bg gms-main-text gms-hover-bg-light border gms-border-medium">Expand all</button>
							<button type="button" id="apiCollapseAll" class="px-3 py-1 rounded gms-content-bg gms-main-text gms-hover-bg-light border gms-border-medium">Collapse all</button>
						</div>

						for _, g := range apiGroups {
							@endpointGroup(g)
						}

						<div class="text-xs gms-demo-accent-text mt-8 text-center">
							<p>All requests/responses are JSON. Errors return { "{" }"error": "..."{ "}" } with a 4xx/5xx status.</p>
						</div>
					</div>
				</main>

				<footer class="gms-dark-bg gms-light-text p-4 text-center gms-accent-text">
					<p>&copy; 2026 Mantas "IndomitableWastage" Jurevičius</p>
				</footer>
			</div>

			<script src="/assets/jsscripts/colour_swap.js"></script>
			<script src="/assets/jsscripts/api_docs.js"></script>
		</body>
	</html>
}

templ endpointGroup(g apiGroup) {
	<div class="mb-6">
		<h2 class="text-lg font-bold gms-light-text mb-2">{ g.Title }</h2>
		<div class="space-y-2">
			for _, e := range g.Endpoints {
				@endpointCard(e)
			}
		</div>
	</div>
}

templ endpointCard(e apiEndpoint) {
	<details class="api-endpoint gms-content-bg gms-main-text rounded-lg shadow-lg border-2 gms-border-medium">
		<summary class="p-3 cursor-pointer flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
			<span class={ "text-xs font-bold px-2 py-0.5 rounded w-fit", methodColor(e.Method) }>{ e.Method }</span>
			<code class="text-sm font-bold break-all">{ e.Path }</code>
			if e.Auth {
				<span class="text-xs gms-dark-text">(auth required)</span>
			}
			<span class="text-xs gms-dark-text sm:ml-auto">{ e.Summary }</span>
		</summary>
		<div class="p-3 border-t-2 gms-border-medium space-y-4">
			if len(e.Params) > 0 {
				<div>
					<h3 class="text-sm font-bold mb-1">Parameters</h3>
					<div class="overflow-x-auto">
						<table class="text-xs w-full">
							<tbody>
								for _, p := range e.Params {
									<tr class="align-top border-b gms-border-medium">
										<td class="py-1 pr-3 whitespace-nowrap"><code class="font-bold">{ p.Name }</code></td>
										<td class="py-1 pr-3 whitespace-nowrap">{ p.In }</td>
										<td class="py-1 pr-3 whitespace-nowrap">{ p.Type }</td>
										<td class="py-1 pr-3 whitespace-nowrap">
											if p.Required {
												required
											} else {
												optional
											}
										</td>
										<td class="py-1">{ p.Desc }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
			if e.Request != "" {
				<div>
					<h3 class="text-sm font-bold mb-1">Request body</h3>
					@jsonBlock(e.Request)
				</div>
			}
			<div>
				<h3 class="text-sm font-bold mb-1">Responses</h3>
				<div class="space-y-2">
					for _, r := range e.Responses {
						<div>
							<p class="text-xs mb-1"><span class={ "font-bold px-2 py-0.5 rounded", statusColor(r.Status) }>{ statusText(r.Status) }</span> { r.Desc }</p>
							if r.Body != "" {
								@jsonBlock(r.Body)
							}
						</div>
					}
				</div>
			</div>
			if len(e.Notes) > 0 {
				<div>
					<h3 class="text-sm font-bold mb-1">Notes</h3>
					<ul class="list-disc pl-5 text-xs space-y-0.5">
						for _, n := range e.Notes {
							<li>{ n }</li>
						}
					</ul>
				</div>
			}
		</div>
	</details>
}

templ jsonBlock(body string) {
	<pre class="gms-dark-bg gms-light-text rounded p-2 text-xs overflow-x-auto"><code>{ body }</code></pre>
}

func statusText(status int) string {
	return strconv.Itoa(status)
}

func statusColor(status int) string {
	switch {
	case status < 300:
		return "bg-green-600 text-white"
	case status < 500:
		return "bg-orange-600 text-white"
	default:
		return "bg-red-600 text-white"
	}
}

func methodColor(method string) string {
	switch method {
	case "GET":
		return "bg-blue-600 text-white"
	case "POST":
		return "bg-green-600 text-white"
	case "PATCH":
		return "bg-yellow-600 text-white"
	case "DELETE":
		return "bg-red-600 text-white"
	default:
		return "bg-gray-600 text-white"
	}
}