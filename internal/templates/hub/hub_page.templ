package hub

templ HubPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable - Hub</title>
			<meta charset="utf-8"/>
			<link rel="icon" type="image/png" href="/assets/images/favicon.png"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link id="themeCSS" rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<link id="themeCSSAlt" rel="stylesheet" href="/assets/css/CTStyleAlt.css" disabled/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body { height: 100%; }
				:root { font-family: 'Lora', serif; }
				a { color: inherit; }
			</style>
		</head>
		<body>
			<div class="min-h-screen flex flex-col gms-dark-bg">
				<header class="gms-dark-bg gms-light-text p-2 shadow-md border-b-4 gms-border-dark">
					<div class="container mx-auto text-center">
						<h1 class="gms-title-text lg:text-4xl sm:text-3xl font-bold mb-1">CommonTable</h1>
						<p class="text-sm gms-demo-accent-text">Hub</p>
					</div>
				</header>

				<nav class="border-b-4 gms-border-dark uppercase font-bold sticky top-0 z-50 flex gms-content-bg">
					<a href="/api-docs" class="flex-1 block py-2 text-center gms-content-bg gms-main-text gms-hover-bg-light">API Docs</a>
					<a href="#" id="MColour" class="flex-1 block py-2 text-center gms-content-bg gms-main-text gms-hover-bg-light border-l-2 gms-border-medium">Palette Swap</a>
				</nav>

				<main class="flex-1 px-6 py-6 gms-content-bg gms-main-text">
					<div class="w-full lg:w-[65%] mx-auto space-y-8">
						<section>
							<h2 class="text-sm font-bold uppercase tracking-wide gms-main-text mb-3">Public</h2>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<a href="/" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Customer</p>
									<p class="text-xs gms-demo-accent-text mt-1">Browse restaurants and menus</p>
								</a>
								<a href="/terminal/login" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Terminal</p>
									<p class="text-xs gms-demo-accent-text mt-1">Payment terminal simulation</p>
								</a>
							</div>
						</section>

						<section>
							<h2 class="text-sm font-bold uppercase tracking-wide gms-main-text mb-3">Restaurant Staff</h2>
							<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
								<a href="/staff/login" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Staff</p>
									<p class="text-xs gms-demo-accent-text mt-1">Waiter profile &amp; chat</p>
								</a>
								<a href="/chef/login" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Kitchen</p>
									<p class="text-xs gms-demo-accent-text mt-1">Chef login</p>
								</a>
								<a href="/kitchen/login" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Kitchen Board</p>
									<p class="text-xs gms-demo-accent-text mt-1">Order display login</p>
								</a>
								<a href="/manager/login" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Manager</p>
									<p class="text-xs gms-demo-accent-text mt-1">Manager login</p>
								</a>
							</div>
						</section>

						<section>
							<h2 class="text-sm font-bold uppercase tracking-wide gms-main-text mb-3">Administration</h2>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<a href="/admin/login" class="block gms-dark-bg gms-light-text rounded-lg shadow-lg p-6 text-center transition-all duration-300 hover:shadow-xl">
									<p class="text-lg font-bold">Admin</p>
									<p class="text-xs gms-demo-accent-text mt-1">Admin login</p>
								</a>
							</div>
						</section>

						<section>
                        	<h2 class="text-sm font-bold uppercase tracking-wide gms-main-text mb-3">Resources</h2>
                        	<div class="flex flex-col sm:flex-row gap-4">
                        		<a href="/download/waiter-app.apk" class="flex-1 gms-dark-bg gms-light-text rounded-lg shadow-lg px-6 py-3 text-center transition-all duration-300 hover:shadow-xl">
                        			<p class="text-sm font-bold">⬇ Download Waiter App (APK)</p>
                        		</a>
                        		<a href="/api-docs" class="flex-1 gms-dark-bg gms-light-text rounded-lg shadow-lg px-6 py-3 text-center transition-all duration-300 hover:shadow-xl">
                        			<p class="text-sm font-bold">📖 Waiter API Docs</p>
                        		</a>
                        		<a href="/api-docs/export" class="flex-1 gms-dark-bg gms-light-text rounded-lg shadow-lg px-6 py-3 text-center transition-all duration-300 hover:shadow-xl">
                        			<p class="text-sm font-bold">📦 Menu Export Docs</p>
                        		</a>
                        	</div>
                        </section>
					</div>
				</main>

				<footer class="gms-dark-bg gms-light-text p-4 text-center gms-accent-text">
					<p>&copy; 2026 Mantas "IndomitableWastage" Jurevičius</p>
				</footer>
			</div>

			<script src="/assets/jsscripts/colour_swap.js"></script>
		</body>
	</html>
}