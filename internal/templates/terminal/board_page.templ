package terminal

import "strconv"

type PendingOrderView struct {
	OrderID     int32
	OrderNumber int32
	TableLabel  string
	Remaining   float64
}

templ BoardPage(restaurantName string, orders []PendingOrderView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable Terminal - { restaurantName }</title>
			<meta charset="utf-8"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		</head>
		<body class="min-h-screen gms-dark-bg gms-light-text p-6">
			<div class="max-w-2xl mx-auto">
				<div class="flex justify-between items-center mb-6">
					<h1 class="text-2xl font-bold">{ restaurantName } — Terminal</h1>
					<a href="/terminal/logout" class="text-sm underline">Deactivate</a>
				</div>

				<div class="space-y-4">
					for _, o := range orders {
						<div class="gms-content-bg gms-main-text rounded-lg shadow-lg p-4">
							<div class="flex justify-between items-center mb-3">
								<div>
									<p class="font-bold">{ o.TableLabel }</p>
									<p class="text-xs opacity-70">Order #{ strconv.Itoa(int(o.OrderNumber)) }</p>
								</div>
								<p class="text-xl font-bold">€{ formatAmount(o.Remaining) }</p>
							</div>
							<div class="flex gap-2">
								<form method="POST" action={ templ.URL("/terminal/orders/" + strconv.Itoa(int(o.OrderID)) + "/simulate") }>
									<input type="hidden" name="outcome" value="success"/>
									<button type="submit" class="px-4 py-2 text-sm font-bold rounded-md shadow gms-btn-submit border gms-border-medium">
										💳 Simulate Tap — Approve
									</button>
								</form>
								<form method="POST" action={ templ.URL("/terminal/orders/" + strconv.Itoa(int(o.OrderID)) + "/simulate") }>
									<input type="hidden" name="outcome" value="declined"/>
									<button type="submit" class="px-4 py-2 text-sm font-bold rounded-md shadow gms-btn-clear border gms-border-medium">
										Simulate Tap — Decline
									</button>
								</form>
							</div>
						</div>
					}
					if len(orders) == 0 {
						<p class="text-center italic opacity-70">No orders currently awaiting payment.</p>
					}
				</div>
			</div>
		</body>
	</html>
}

func formatAmount(amount float64) string {
	return strconv.FormatFloat(amount, 'f', 2, 64)
}