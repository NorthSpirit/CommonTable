package templates

templ RestaurantsPage(restaurants []RestaurantView) {
	@Layout("Restaurants", nil, restaurantsPageContent(restaurants))
}

templ restaurantsPageContent(restaurants []RestaurantView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">Restaurants</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, restaurant := range restaurants {
				@RestaurantCard(restaurant)
			}
			if len(restaurants) == 0 {
				<p class="text-center italic gms-main-text col-span-full">No restaurants found.</p>
			}
		</div>
	</main>
}