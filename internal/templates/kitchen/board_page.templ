package kitchen

import "strconv"

templ BoardPage(employeeName string, orders []KitchenOrderView) {
	@Layout(employeeName, boardContent(orders))
}

templ boardContent(orders []KitchenOrderView) {
	<div id="order-board" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
		for _, order := range orders {
			@orderCard(order)
		}
		if len(orders) == 0 {
			<p class="text-center italic gms-main-text col-span-full">No active orders.</p>
		}
	</div>
	<script src="/assets/jsscripts/kitchen_poll.js"></script>
}

templ orderCard(order KitchenOrderView) {
	<div class="border gms-border-medium rounded-lg shadow-lg overflow-hidden gms-content-bg">
		<div class="gms-dark-bg gms-light-text px-3 py-2 flex justify-between items-center">
			<span class="font-bold">Table { itoa(order.TableNumber) }</span>
			<span class="text-xs uppercase opacity-80">{ order.Status }</span>
		</div>
		<div class="p-3">
			<p class="text-xs opacity-60 mb-2">Order #{ itoa(order.OrderNumber) } — { order.CreatedAt }</p>
			<ul class="text-sm gms-main-text mb-3 space-y-1">
				for _, item := range order.Items {
					<li>
						<span class="font-semibold">{ itoa(item.Quantity) }x</span> { item.Name }
						if item.Notes != "" {
							<span class="block text-xs opacity-70 pl-4">{ item.Notes }</span>
						}
					</li>
				}
			</ul>
			if order.Notes != "" {
				<p class="text-xs italic opacity-70 mb-3">Note: { order.Notes }</p>
			}
			if order.NextStatus != "" {
				<form method="POST" action="/kitchen/orders/status">
					<input type="hidden" name="order_id" value={ itoa(order.ID) }/>
					<input type="hidden" name="status" value={ order.NextStatus }/>
					<button type="submit" class="w-full px-3 py-2 text-sm font-bold rounded-md shadow gms-btn-submit border gms-border-medium">
						{ order.NextStatusLabel }
					</button>
				</form>
			}
		</div>
	</div>
}

func itoa(n int32) string {
	return strconv.Itoa(int(n))
}