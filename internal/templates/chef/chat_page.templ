package chef

import "strconv"

templ ChatPage(employeeName string, restaurantName string, messages []ChatMessageView) {
	@Layout(restaurantName+" - Chat", employeeName, chatPageContent(messages))
}

templ chatPageContent(messages []ChatMessageView) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold gms-main-text mb-6 border-b-2 gms-border-medium pb-4">Restaurant Chat</h2>

		<div class="max-w-3xl mx-auto w-full">
			<div id="chat-messages" data-last-id={ lastMessageID(messages) } class="gms-dark-bg rounded-lg p-4 h-96 overflow-y-auto space-y-2 mb-4">
				for _, m := range messages {
					@chatMessageRow(m)
				}
				if len(messages) == 0 {
					<p class="text-center italic gms-demo-accent-text">No messages yet.</p>
				}
			</div>

			<form id="chat-form" method="POST" action="/chef/chat/send" class="flex gap-2">
				<input type="text" id="chat-input" name="message" data-validate="generic" required autocomplete="off" placeholder="Type a message..." class="p-2 border gms-border-medium rounded-md w-full"/>
				<button type="submit" class="px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium whitespace-nowrap">
					Send
				</button>
			</form>
		</div>
	</main>

	<script src="/assets/jsscripts/chat_height.js"></script>
	<script src="/assets/jsscripts/whitelist_blacklist_chars.js"></script>
	<script src="/assets/jsscripts/form_validation.js"></script>
	<script src="/assets/jsscripts/chat_poll.js"></script>
}

templ chatMessageRow(m ChatMessageView) {
	<div class="text-sm gms-light-text" data-message-id={ strconv.Itoa(int(m.ID)) }>
		<span class="font-bold">{ m.SenderName }</span>
		<span class="opacity-70">({ m.SentAt }):</span>
		{ " " + m.Message }
	</div>
}

func lastMessageID(messages []ChatMessageView) string {
	if len(messages) == 0 {
		return "0"
	}
	return strconv.Itoa(int(messages[len(messages)-1].ID))
}