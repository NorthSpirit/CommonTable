package chef

import "strconv"

templ ChatPage(employeeName string, restaurantName string, messages []ChatMessageView) {
	@Layout(restaurantName+" - Chat", employeeName, chatPageContent(messages))
}

templ chatPageContent(messages []ChatMessageView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text max-w-3xl mx-auto w-full">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">Restaurant Chat</h2>

		<div id="chat-messages" data-last-id={ lastMessageID(messages) } class="border gms-border-medium rounded-lg p-4 mb-4 h-96 overflow-y-auto space-y-2">
			for _, m := range messages {
				@chatMessageRow(m)
			}
		</div>

		<form id="chat-form" method="POST" action="/chef/chat/send" class="flex gap-2">
			<input type="text" name="message" required autocomplete="off" placeholder="Type a message..." class="p-2 border gms-border-medium rounded-md w-full"/>
			<button type="submit" class="px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium whitespace-nowrap">
				Send
			</button>
		</form>
	</main>

	<script src="/assets/jsscripts/chat_poll.js"></script>
}

templ chatMessageRow(m ChatMessageView) {
	<div class="text-sm gms-main-text" data-message-id={ strconv.Itoa(int(m.ID)) }>
		<span class="font-bold">{ m.SenderName }</span>
		<span class="opacity-60">({ m.SentAt }):</span>
		{ " " + m.Message }
	</div>
}

func lastMessageID(messages []ChatMessageView) string {
	if len(messages) == 0 {
		return "0"
	}
	return strconv.Itoa(int(messages[len(messages)-1].ID))
}