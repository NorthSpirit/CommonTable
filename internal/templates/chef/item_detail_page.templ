package chef

import "strconv"

templ ChefItemDetailPage(employeeName string, item ChefItemDetailView, successMessage string) {
	@Layout(item.Name, employeeName, chefItemDetailContent(item, successMessage))
}

templ chefItemDetailContent(item ChefItemDetailView, successMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@BackLink("/chef/menus/"+strconv.Itoa(int(item.MenuID)), "Back")
			<h2 class="text-2xl font-bold gms-main-text">{ item.Name }</h2>
		</div>

		<div class="w-full lg:w-[65%] mx-auto">
			if successMessage != "" {
				<p class="mb-4 p-2 rounded bg-green-100 text-green-800 text-sm">{ successMessage }</p>
			}

			if item.ImageURL != "" {
				<img src={ item.ImageURL } alt={ item.Name } class="w-full max-h-72 object-cover rounded-lg border gms-border-medium mb-4"/>
			}
			if item.Description != "" {
				<p class="gms-main-text opacity-80 mb-6">{ item.Description }</p>
			}

			<div class="border gms-border-medium rounded-lg p-4 mb-6">
				<h3 class="text-lg font-semibold mb-2 gms-main-text">Preparation Instructions</h3>
				<form id="instructions-form" method="POST" action={ templ.URL("/chef/menus/" + strconv.Itoa(int(item.MenuID)) + "/items/" + strconv.Itoa(int(item.ID)) + "/instructions") }>
					<textarea name="instructions" rows="6" class="p-2 border gms-border-medium rounded-md w-full">{ item.Instructions }</textarea>
				</form>

				<div class="flex justify-end items-center gap-2 mt-4 pt-4 border-t gms-border-medium">
					<form method="POST" action={ templ.URL("/chef/menus/" + strconv.Itoa(int(item.MenuID)) + "/items/" + strconv.Itoa(int(item.ID)) + "/availability") }>
						if item.IsAvailable {
							<input type="hidden" name="available" value="false"/>
							<button type="submit" class="px-4 py-2 font-bold rounded-lg shadow-md gms-btn-clear border gms-border-medium">
								Mark as Unavailable
							</button>
						} else {
							<input type="hidden" name="available" value="true"/>
							<button type="submit" class="px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
								Mark as Available
							</button>
						}
					</form>
					<button type="submit" form="instructions-form" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium">
						Save Instructions
					</button>
				</div>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<div class="border gms-border-medium rounded-lg p-4">
					<h3 class="text-lg font-semibold mb-2 gms-main-text">Ingredients</h3>
					if len(item.Ingredients) == 0 {
						<p class="gms-main-text italic opacity-70">No ingredients listed.</p>
					} else {
						<ul class="list-disc pl-5 gms-main-text">
							for _, ing := range item.Ingredients {
								<li>
									{ ing.Name }
									if ing.Measurement != "" {
										<span class="opacity-70"> ({ formatAmount(ing.Amount) } { ing.Measurement })</span>
									}
								</li>
							}
						</ul>
					}
				</div>

				<div class="border gms-border-medium rounded-lg p-4">
					<h3 class="text-lg font-semibold mb-2 gms-main-text">Allergens</h3>
					if len(item.Allergens) == 0 {
						<p class="gms-main-text italic opacity-70">No known allergens listed.</p>
					} else {
						<ul class="list-disc pl-5 gms-main-text">
							for _, allergen := range item.Allergens {
								<li>{ allergen }</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	</main>
}

func formatAmount(amount float64) string {
	return strconv.FormatFloat(amount, 'f', -1, 64)
}