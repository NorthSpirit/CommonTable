package chef

templ MenusPage(restaurantName string, menus []ChefMenuView) {
	@Layout(restaurantName+" - Menus", menusPageContent(menus))
}

templ menusPageContent(menus []ChefMenuView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold mb-6 gms-main-text text-center border-b-2 gms-border-medium pb-2">Menus</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, menu := range menus {
				<a href={ templ.URL("/chef/menus/" + itoa(menu.ID)) } class="block gms-hover-bg-light border gms-border-medium rounded-lg shadow p-4">
					<h3 class="text-xl font-bold gms-main-text">{ menu.Name }</h3>
					if menu.Description != "" {
						<p class="text-sm gms-main-text mt-1">{ menu.Description }</p>
					}
				</a>
			}
			if len(menus) == 0 {
				<p class="text-center italic gms-main-text col-span-full">No menus yet.</p>
			}
		</div>
	</main>
}