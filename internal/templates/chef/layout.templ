package chef

templ Layout(title string, employeeName string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable Kitchen - { title }</title>
			<meta charset="utf-8"/>
			<link rel="icon" type="image/png" href="/assets/images/favicon.png"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link id="themeCSS" rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<link id="themeCSSAlt" rel="stylesheet" href="/assets/css/CTStyleAlt.css" disabled/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body { height: 100%; }
				:root { font-family: 'Lora', serif; }
				a { color: inherit; }
			</style>
		</head>
		<body>
			<div class="min-h-screen flex flex-col gms-dark-bg">
				<header class="gms-dark-bg gms-light-text p-2 shadow-md">
					<div class="container mx-auto text-center">
						<h1 class="gms-title-text lg:text-3xl sm:text-2xl font-bold mb-1">CommonTable Kitchen</h1>
						<p class="text-sm gms-demo-accent-text">{ title }</p>
						if employeeName != "" {
							<p class="text-xs opacity-80 mt-1">Logged in as { employeeName }</p>
						}
					</div>
				</header>

				<nav class="border-b-4 gms-border-dark uppercase font-bold sticky top-0 z-50 flex flex-col md:flex-row md:justify-center gms-content-bg">
					<div class="md:hidden w-full">
						<button id="menu-toggle" class="px-4 py-1 w-full flex items-center justify-between gms-main-text gms-hover-bg-light rounded">
							<div class="flex items-center space-x-2">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
								</svg>
								<span class="text-base font-bold tracking-wider">Menu</span>
							</div>
						</button>
					</div>

					<ul id="menu-items" class="hidden md:flex list-none m-0 w-full flex-col md:flex-row md:justify-center md:items-stretch text-center">
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/chef/menus" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Menus</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/chef/profile" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">My Profile</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
                        	<a id="nav-chat-link" href="/chef/chat" data-poll-url="/chef/chat/messages" data-storage-key="chat_last_read_chef" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Chat</a>
                        </li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="#" id="MColour" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Palette Swap</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/chef/logout" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Logout</a>
						</li>
					</ul>
				</nav>

				<div class="flex flex-col flex-1">
					@content
				</div>

				<footer class="gms-dark-bg gms-light-text p-4 text-center gms-accent-text">
					<p>&copy; 2026 Mantas "IndomitableWastage" Jurevičius</p>
				</footer>
			</div>

			<script src="/assets/jsscripts/hamburger.js"></script>
			<script src="/assets/jsscripts/chat_unread.js"></script>
			<script src="/assets/jsscripts/colour_swap.js"></script>
		</body>
	</html>
}