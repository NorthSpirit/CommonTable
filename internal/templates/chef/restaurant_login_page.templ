package chef

templ RestaurantLoginPage(errorMessage string) {
	@Layout("Log In", "", restaurantLoginContent(errorMessage))
}

templ restaurantLoginContent(errorMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold gms-main-text mb-6 border-b-2 gms-border-medium pb-4">Restaurant Log In</h2>

		<div class="w-full lg:w-[65%] mx-auto p-6 rounded-lg shadow-lg border gms-border-medium gms-dark-bg">
			if errorMessage != "" {
				<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
			}

			<form method="POST" action="/chef/login" class="space-y-4">
				<label class="block">
					<span class="text-sm font-medium mb-1 block gms-demo-accent-text">Restaurant Name</span>
					<input type="text" name="restaurant_name" required autofocus class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium mb-1 block gms-demo-accent-text">Restaurant Password</span>
					<input type="password" name="password" required class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<button type="submit" class="w-full px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
					Continue
				</button>
			</form>
		</div>
	</main>
}