package manager

templ DashboardPage(restaurantName string, employeeName string) {
	@Layout(restaurantName+" - Dashboard", employeeName, dashboardContent(restaurantName))
}

templ dashboardContent(restaurantName string) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text flex items-center justify-center">
		<div class="text-center">
			<h2 class="text-2xl font-bold mb-2">Welcome, { restaurantName } Manager</h2>
			<p class="opacity-70">Menu/employee/order management sections coming next.</p>
		</div>
	</main>
}