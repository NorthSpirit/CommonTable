package manager

templ MenusPage(restaurantName string, employeeName string, menus []MenuView) {
	@Layout(restaurantName+" - Menus", employeeName, menusPageContent(menus))
}

templ menusPageContent(menus []MenuView) {
	<main class="flex-1 p-6 gms-content-bg gms-main-text">
		<div class="flex justify-between items-center mb-6 border-b-2 gms-border-medium pb-2">
			<h2 class="text-2xl font-bold gms-main-text">Menus</h2>
			<a href="/manager/menus/new" class="px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
				+ New Menu
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, m := range menus {
				<div class="border gms-border-medium rounded-lg shadow-lg overflow-hidden">
					<div class="h-32 w-full bg-gray-200 flex items-center justify-center">
						if m.ImageURL != "" {
							<img src={ m.ImageURL } alt={ m.Name } class="h-full w-full object-cover"/>
						} else {
							<div class="text-gray-500 italic">No Image</div>
						}
					</div>
					<div class="p-4">
						<h3 class="text-lg font-bold gms-main-text">{ m.Name }</h3>
						<div class="flex gap-2 mt-3">
							<a href={ templ.URL("/manager/menus/" + itoa(m.ID)) } class="px-3 py-1 text-sm font-bold rounded-md shadow gms-btn-submit border gms-border-medium">
								View Items
							</a>
							<a href={ templ.URL("/manager/menus/" + itoa(m.ID) + "/edit") } class="px-3 py-1 text-sm font-bold rounded-md shadow gms-btn-clear border gms-border-medium">
								Edit
							</a>
							<form method="POST" action={ templ.URL("/manager/menus/" + itoa(m.ID) + "/delete") } onsubmit="return confirm('Delete this menu? Items on it are unaffected.');">
								<button type="submit" class="px-3 py-1 text-sm font-bold rounded-md shadow gms-btn-clear border gms-border-medium">Delete</button>
							</form>
						</div>
					</div>
				</div>
			}
			if len(menus) == 0 {
				<p class="text-center italic gms-main-text col-span-full">No menus yet.</p>
			}
		</div>
	</main>
}