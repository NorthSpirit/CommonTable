package manager

templ OrderFormPage(employeeName string, tables []TableOptionView, waiters []EmployeeOptionView, items []MenuItemOptionView, errorMessage string) {
	@Layout("New Order", employeeName, orderFormContent(tables, waiters, items, errorMessage))
}

templ orderFormContent(tables []TableOptionView, waiters []EmployeeOptionView, items []MenuItemOptionView, errorMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@BackLink("/manager/orders", "Back")
			<h2 class="text-2xl font-bold gms-main-text">
				Create Order Manually
			</h2>
		</div>

		if errorMessage != "" {
			<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm w-full lg:w-[65%] mx-auto">{ errorMessage }</p>
		}

		<form method="POST" action="/manager/orders/new" class="w-full lg:w-[65%] mx-auto">
			<fieldset class="border p-4 rounded-lg gms-border-medium mb-4">
				<legend class="text-lg font-semibold px-2">Order Details</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Table</span>
					<select name="table_id" required class="p-2 border gms-border-medium rounded-md w-full">
						<option value="0">Take-Out (no table)</option>
						for _, t := range tables {
							<option value={ itoa(t.ID) }>Table { itoa(t.Number) }</option>
						}
					</select>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Waiter</span>
					<select name="waiter_id" required class="p-2 border gms-border-medium rounded-md w-full">
						for _, e := range waiters {
							<option value={ itoa(e.ID) }>{ e.Name }</option>
						}
					</select>
				</label>

				<label class="block">
					<span class="text-sm font-medium mb-1 block">Notes</span>
					<textarea name="notes" rows="2" class="p-2 border gms-border-medium rounded-md w-full"></textarea>
				</label>
			</fieldset>

			<fieldset class="border p-4 rounded-lg gms-border-medium mb-4">
				<legend class="text-lg font-semibold px-2">Items</legend>
				<div class="max-h-64 overflow-y-auto border gms-border-medium rounded p-2">
					for _, item := range items {
						<label class="flex items-center gap-2 py-1">
							<input type="number" name={ "quantity_" + itoa(item.ID) } min="0" value="0" class="p-1 border gms-border-medium rounded w-16"/>
							<span class="text-sm">{ item.Name } — €{ formatPrice(item.Price) }</span>
						</label>
					}
				</div>
				<p class="text-xs opacity-70 mt-2">Set a quantity above 0 for each item to include.</p>
			</fieldset>

			<div class="flex justify-end">
				<input type="submit" value="Create Order" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>
	</main>
}