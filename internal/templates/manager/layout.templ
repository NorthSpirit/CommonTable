package manager

templ Layout(title string, employeeName string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable Manager - { title }</title>
			<meta charset="utf-8"/>
			<link rel="icon" href="data:,"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link id="themeCSS" rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<link id="themeCSSAlt" rel="stylesheet" href="/assets/css/CTStyleAlt.css" disabled/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body { height: 100%; }
				:root { font-family: 'Lora', serif; }
				a { color: inherit; }
			</style>
		</head>
		<body>
			<div class="min-h-screen flex flex-col gms-dark-bg">
				<header class="gms-dark-bg gms-light-text p-2 shadow-md">
					<div class="container mx-auto text-center">
						<h1 class="gms-title-text lg:text-3xl sm:text-2xl font-bold mb-1">CommonTable Manager</h1>
						<p class="text-sm gms-demo-accent-text">{ title }</p>
						if employeeName != "" {
							<p class="text-xs opacity-80 mt-1">Logged in as { employeeName }</p>
						}
					</div>
				</header>

				<nav class="border-b-4 gms-border-dark uppercase font-bold sticky top-0 z-50 flex flex-col md:flex-row md:justify-center gms-content-bg">
					<ul class="list-none m-0 w-full flex flex-col md:flex-row md:justify-center md:items-stretch text-center">
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Dashboard</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager/menus" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Menus</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager/employees" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Employees</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager/orders" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Orders</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager/chat" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Chat</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager/profile" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Restaurant Profile</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="#" id="MColour" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Palette Swap</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="/manager/logout" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">Logout</a>
						</li>
					</ul>
				</nav>

				<div class="flex flex-col flex-1">
					@content
				</div>

				<footer class="gms-dark-bg gms-light-text p-4 text-center gms-accent-text">
					<p>&copy; 2026 CommonTable Manager</p>
				</footer>
			</div>

			<script src="/assets/jsscripts/colour_swap.js"></script>
		</body>
	</html>
}