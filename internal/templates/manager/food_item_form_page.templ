package manager

templ FoodItemFormPage(employeeName string, menuID int32, isEdit bool, item FoodItemView, allergens []AllergenCheckboxView, ingredientOptions []IngredientOptionView, itemIngredients []ItemIngredientView, errorMessage string) {
	@Layout(itemFormTitle(isEdit), employeeName, foodItemFormContent(menuID, isEdit, item, allergens, ingredientOptions, itemIngredients, errorMessage))
}

func itemFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit Food Item"
	}
	return "New Food Item"
}

func itemFormAction(menuID int32, isEdit bool, itemID int32) templ.SafeURL {
	base := "/manager/menus/" + itoa(menuID) + "/items"
	if isEdit {
		return templ.URL(base + "/" + itoa(itemID) + "/edit")
	}
	return templ.URL(base + "/new")
}

templ foodItemFormContent(menuID int32, isEdit bool, item FoodItemView, allergens []AllergenCheckboxView, ingredientOptions []IngredientOptionView, itemIngredients []ItemIngredientView, errorMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<div class="flex items-center gap-4 mb-6 border-b-2 gms-border-medium pb-4">
			@BackLink("/manager/menus/"+itoa(menuID), "Back")
			<h2 class="text-2xl font-bold gms-main-text">
				{ itemFormTitle(isEdit) }
			</h2>
		</div>

		if errorMessage != "" {
			<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm">{ errorMessage }</p>
		}

		<form method="POST" action={ itemFormAction(menuID, isEdit, item.ID) } enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Details</legend>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Name</span>
					<input type="text" name="name" value={ item.Name } maxlength="255" required class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Name (Alt Language)</span>
					<input type="text" name="name_alt" value={ item.NameAlt } maxlength="255" class="p-2 border gms-border-medium rounded-md w-full"/>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Description</span>
					<textarea name="description" rows="3" class="p-2 border gms-border-medium rounded-md w-full">{ item.Description }</textarea>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Description (Alt Language)</span>
					<textarea name="description_alt" rows="3" class="p-2 border gms-border-medium rounded-md w-full">{ item.DescriptionAlt }</textarea>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Instructions / Preparation Notes</span>
					<textarea name="instructions" rows="3" class="p-2 border gms-border-medium rounded-md w-full">{ item.Instructions }</textarea>
				</label>

				<label class="block mb-4">
					<span class="text-sm font-medium mb-1 block">Instructions (Alt Language)</span>
					<textarea name="instructions_alt" rows="3" class="p-2 border gms-border-medium rounded-md w-full">{ item.InstructionsAlt }</textarea>
				</label>

				<div class="grid grid-cols-2 gap-4 mb-4">
					<label class="block">
						<span class="text-sm font-medium mb-1 block">Price (€)</span>
						<input type="number" step="0.01" min="0" max="100000" name="price" value={ formatPrice(item.Price) } required class="p-2 border gms-border-medium rounded-md w-full"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium mb-1 block">Prep Time (mins)</span>
						<input type="number" min="0" max="1000" name="prep_time_mins" value={ itoa(item.PrepTimeMins) } class="p-2 border gms-border-medium rounded-md w-full"/>
					</label>
				</div>

				<label class="flex items-center gap-2">
					<input type="checkbox" name="is_available" checked?={ item.IsAvailable }/>
					<span class="text-sm font-medium">Available on menu</span>
				</label>
			</fieldset>

			<fieldset class="border p-4 rounded-lg gms-border-medium">
				<legend class="text-lg font-semibold px-2">Image</legend>

				<img id="item-image-preview" src={ item.ImageURL } alt="Item image preview" class={ "h-40 w-full object-cover rounded border gms-border-medium mb-4", templ.KV("hidden", item.ImageURL == "") }/>
				<div id="item-image-preview-placeholder" class={ "h-40 w-full flex items-center justify-center rounded border gms-border-medium mb-4", templ.KV("hidden", item.ImageURL != "") }>
					<p class="text-sm italic opacity-70">No image set.</p>
				</div>

				<label class="block mb-6">
					<span class="text-sm font-medium mb-1 block">Replace Image</span>
					<input type="file" name="image" data-preview-target="item-image-preview" accept=".jpg,.jpeg,.png,.webp" class="p-2 border gms-border-medium rounded-md w-full gms-content-bg gms-main-text"/>
				</label>

				<h4 class="text-md font-semibold mb-2">Allergens</h4>
				<p class="text-xs opacity-70 mb-2">Select from the shared allergen catalog — new allergens can only be added by admin.</p>
				<div class="grid grid-cols-2 gap-1 max-h-48 overflow-y-auto border gms-border-medium rounded p-2">
					for _, allergen := range allergens {
						<label class="flex items-center gap-2">
							<input type="checkbox" name="allergens" value={ itoa(allergen.ID) } checked?={ allergen.Checked }/>
							<span class="text-sm">{ allergen.Name }</span>
						</label>
					}
				</div>

				if !isEdit {
					<p class="text-xs opacity-70 mt-2">Save the item first, then edit it to assign ingredients.</p>
				}
			</fieldset>

			<div class="lg:col-span-2 flex justify-end">
				<input type="submit" value="Save" class="px-4 py-2 font-bold rounded-lg shadow-md cursor-pointer gms-btn-submit border gms-border-medium"/>
			</div>
		</form>

		if isEdit {
			<fieldset class="border p-4 rounded-lg gms-border-medium mt-6">
				<legend class="text-lg font-semibold px-2">Ingredients</legend>

				<div class="max-h-64 overflow-y-auto mb-4">
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b-2 gms-border-medium">
								<th class="text-left p-2">Ingredient</th>
								<th class="text-left p-2 w-32">Amount</th>
								<th class="text-left p-2 w-40">Measurement</th>
								<th class="p-2 w-24"></th>
							</tr>
						</thead>
						<tbody class="divide-y gms-border-medium">
							for _, ing := range itemIngredients {
								<tr>
									<td class="p-2">{ ing.Name }</td>
									<td class="p-2">{ formatPrice(ing.Amount) }</td>
									<td class="p-2">{ ing.Measurement }</td>
									<td class="p-2">
										<form method="POST" action={ templ.URL("/manager/menus/" + itoa(menuID) + "/items/" + itoa(item.ID) + "/ingredients/" + itoa(ing.IngredientID) + "/remove") }>
											<button type="submit" class="w-full px-2 py-1 text-xs font-bold rounded-md gms-btn-clear border gms-border-medium">Remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<form method="POST" action={ templ.URL("/manager/menus/" + itoa(menuID) + "/items/" + itoa(item.ID) + "/ingredients/add") } class="border gms-border-medium rounded p-3">
						<p class="text-sm font-semibold mb-2">Add existing ingredient</p>
						<select name="ingredient_id" required class="p-2 border gms-border-medium rounded-md w-full mb-2">
							<option value="">-- Select --</option>
							for _, opt := range ingredientOptions {
								<option value={ itoa(opt.ID) }>{ opt.Name }</option>
							}
						</select>
						<div class="flex gap-2 mb-2">
							<input type="number" step="0.01" min="0" name="amount" placeholder="Amount" class="p-2 border gms-border-medium rounded-md w-full"/>
							<input type="text" name="measurement" placeholder="Unit (g, ml...)" class="p-2 border gms-border-medium rounded-md w-full"/>
						</div>
						<button type="submit" class="w-full px-3 py-2 text-sm font-bold rounded-md shadow gms-btn-submit border gms-border-medium">Add</button>
					</form>

					<form method="POST" action={ templ.URL("/manager/menus/" + itoa(menuID) + "/items/" + itoa(item.ID) + "/ingredients/create") } class="border gms-border-medium rounded p-3">
						<p class="text-sm font-semibold mb-2">Can't find it? Create it</p>
						<input type="text" name="new_ingredient_name" placeholder="Ingredient name" maxlength="255" required class="p-2 border gms-border-medium rounded-md w-full mb-2"/>
						<div class="flex gap-2 mb-2">
							<input type="number" step="0.01" min="0" name="amount" placeholder="Amount" class="p-2 border gms-border-medium rounded-md w-full"/>
							<input type="text" name="measurement" placeholder="Unit (g, ml...)" class="p-2 border gms-border-medium rounded-md w-full"/>
						</div>
						<button type="submit" class="w-full px-3 py-2 text-sm font-bold rounded-md shadow gms-btn-submit border gms-border-medium">Create &amp; Add</button>
					</form>
				</div>
			</fieldset>
		}
	</main>

	<script src="/assets/jsscripts/image_preview.js"></script>
}