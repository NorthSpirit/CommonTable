package manager

templ RestaurantLoginPage(errorMessage string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable Manager - Log In</title>
			<meta charset="utf-8"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		</head>
		<body class="min-h-screen flex flex-col items-center justify-center gms-dark-bg gms-light-text p-6">
			<div class="w-full max-w-sm p-6 rounded-lg shadow-lg border gms-border-medium gms-content-bg gms-main-text">
				<h2 class="text-xl font-bold mb-4 text-center">Manager Log In</h2>
				if errorMessage != "" {
					<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
				}
				<form method="POST" action="/manager/login" class="space-y-4">
					<label class="block">
						<span class="text-sm font-medium mb-1 block">Restaurant Name</span>
						<input type="text" name="restaurant_name" required autofocus class="p-2 border gms-border-medium rounded-md w-full"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium mb-1 block">Restaurant Password</span>
						<input type="password" name="password" required class="p-2 border gms-border-medium rounded-md w-full"/>
					</label>
					<button type="submit" class="w-full px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
						Continue
					</button>
				</form>
			</div>
		</body>
	</html>
}