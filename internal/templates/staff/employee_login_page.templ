package staff

import "strconv"

templ EmployeeLoginPage(restaurantID int32, restaurantName string, errorMessage string) {
	@Layout("Log In", "", employeeLoginContent(restaurantID, restaurantName, errorMessage))
}

templ employeeLoginContent(restaurantID int32, restaurantName string, errorMessage string) {
	<main class="flex-1 px-6 py-4 gms-content-bg gms-main-text">
		<h2 class="text-2xl font-bold gms-main-text mb-6 border-b-2 gms-border-medium pb-4">{ restaurantName } - Staff Log In</h2>

		<div class="w-full lg:w-[65%] mx-auto p-6 rounded-lg shadow-lg border gms-border-medium gms-dark-bg">
			if errorMessage != "" {
				<p class="mb-4 p-2 rounded bg-red-100 text-red-800 text-sm text-center">{ errorMessage }</p>
			}

			<form method="POST" action="/staff/login/employee" class="space-y-4">
				<input type="hidden" name="restaurant_id" value={ strconv.Itoa(int(restaurantID)) }/>
				<label class="block">
					<span class="text-sm font-medium mb-1 block gms-demo-accent-text">Your Name</span>
					<input type="text" name="employee_name" required autofocus class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium mb-1 block gms-demo-accent-text">PIN / Password</span>
					<input type="password" name="password" required class="p-2 border rounded-md w-full gms-dark-text"/>
				</label>
				<button type="submit" class="w-full px-4 py-2 font-bold rounded-lg shadow-md gms-btn-submit border gms-border-medium">
					Log In
				</button>
			</form>
		</div>
	</main>
}