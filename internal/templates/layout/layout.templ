package layout

import (
	"CommonTable/internal/templates/helpers"
	"CommonTable/internal/templates/shared"
)

templ Layout(title string, branding *shared.BrandingView, locale string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>CommonTable - { title }</title>
			<meta charset="utf-8"/>
			<link rel="icon" type="image/png" href="/assets/images/favicon.png"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<link id="themeCSS" rel="stylesheet" href="/assets/css/CTStyleMain.css"/>
			<link id="themeCSSAlt" rel="stylesheet" href="/assets/css/CTStyleAlt.css" disabled/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<style>
				html, body { height: 100%; }
				:root { font-family: 'Lora', serif; }
				a { color: inherit; }
			</style>
		</head>
		<body>
			<div id="top" class="min-h-screen flex flex-col gms-dark-bg">
				<header class="gms-dark-bg gms-light-text p-2 shadow-md">
					<div class="container mx-auto text-center">
						if branding != nil {
							<h1 class="gms-title-text lg:text-4xl sm:text-3xl font-bold mb-1 flex items-center justify-center gap-3">
								if branding.LogoURL != "" {
									<img src={ branding.LogoURL } alt={ branding.Name } class="h-10 w-10 rounded-full object-cover"/>
								}
								{ branding.Name }
							</h1>
							<p class="text-xs gms-demo-accent-text">{ shared.T(locale, "powered_by") }</p>
						} else {
							<h1 class="gms-title-text lg:text-4xl sm:text-3xl font-bold mb-1">
								CommonTable
							</h1>
						}
						<p class="text-sm gms-demo-accent-text">{ title }</p>
					</div>
				</header>

				<nav id="menu" class="border-b-4 gms-border-dark uppercase font-bold sticky top-0 z-50 flex flex-col md:flex-row md:justify-center gms-content-bg">
					<div class="md:hidden w-full">
						<button id="menu-toggle" class="px-4 py-1 w-full flex items-center justify-between gms-main-text gms-hover-bg-light rounded">
							<div class="flex items-center space-x-2">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
								</svg>
								<span class="text-base font-bold tracking-wider">{ shared.T(locale, "nav_menu_toggle") }</span>
							</div>
						</button>
					</div>

					<ul id="menu-items" class="hidden md:flex list-none m-0 w-full flex-col md:flex-row md:justify-center md:items-stretch text-center">
						<li class="border gms-border-medium w-full md:flex-1">
                        	<a href={ templ.URL(helpers.WithLang("/", locale)) } class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">{ shared.T(locale, "nav_home") }</a>
                        </li>
                        <li class="border gms-border-medium w-full md:flex-1">
                        	<a href={ templ.URL(helpers.WithLang("/restaurants", locale)) } class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">{ shared.T(locale, "nav_restaurants") }</a>
                        </li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="#" id="MColour" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">{ shared.T(locale, "nav_palette_swap") }</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="?lang=en" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">EN</a>
						</li>
						<li class="border gms-border-medium w-full md:flex-1">
							<a href="?lang=alt" class="block py-1 text-center gms-content-bg gms-main-text gms-hover-bg-light">{ shared.AltLanguageLabel() }</a>
						</li>
					</ul>
				</nav>

				<div class="flex flex-col flex-1">
					@content
				</div>

				<footer class="gms-dark-bg gms-light-text p-4 text-center gms-accent-text">
					<p>&copy; 2026 CommonTable</p>
				</footer>
			</div>

			<script src="/assets/jsscripts/hamburger.js"></script>
			<script src="/assets/jsscripts/colour_swap.js"></script>
		</body>
	</html>
}