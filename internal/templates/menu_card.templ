package templates

templ MenuCard(menu MenuView) {
	<a href={ templ.URL("/menus/" + itoa(menu.ID)) } class="block gms-hover-bg-light border gms-border-medium rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:scale-[1.02] p-4">
		<h3 class="text-xl font-bold mb-1 gms-main-text">{ menu.Name }</h3>
		if menu.Description != "" {
			<p class="gms-main-text text-sm mt-2">{ menu.Description }</p>
		}
	</a>
}